# Copy this file to .env and fill in the blanks:  cp .env.example .env

# ---- Database (matches docker-compose.yml; local dev only) ------------------
DATABASE_URL=postgresql://brd:brd_local_pw@localhost:5433/brd

# ---- Voyage AI — embeddings + reranking (add your key when ready) -----------
VOYAGE_API_KEY=

# ---- OpenRouter — LLM generation (OpenAI-compatible gateway) ----------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Model choices (override only if you need to) ---------------------------
EMBED_MODEL_DOCS=voyage-4
EMBED_MODEL_QUERY=voyage-4-lite
RERANK_MODEL=rerank-2.5
# A free OpenRouter model (these come and go — verify at https://openrouter.ai/models).
# Switch to anthropic/claude-opus-5 (or claude-sonnet-5) once OpenRouter has credits.
GEN_MODEL=nex-agi/nex-n2.5-pro:free
# Max output tokens per answer (default 1500). Raise for longer answers; mind cost
# and small free-model context windows.
GEN_MAX_TOKENS=1500

# ---- Refinement layer ----
# Gated LLM answer-verification (strips claims not supported by cited sources).
# Costs an extra LLM call per answer — best enabled on a strong model. 0 = off.
REFINE_VERIFY=0

# ---- Caching (Postgres-backed, advisory + fail-open) ----
# Memoizes the paid/rate-limited stages: query embeddings, retrieval results, and
# final answers. Busted per-project on ingest/delete; embeddings are immutable. 1 = on.
CACHE_ENABLED=1
# Safety-net TTL (seconds) for retrieve/answer entries; 0 = no age limit
# (busting on ingest is the primary invalidation). Embeddings never expire.
CACHE_TTL_SECONDS=0

# ---- App URL + cookies (auth verification + password reset) ----
# Base URL used to build links in emails; set to your public URL in production.
APP_BASE_URL=http://localhost:8000
# Mark the session cookie Secure — set to 1 in production (HTTPS), 0 for local http.
BRD_SECURE_COOKIES=0

# ---- Email transport ----
# EMAIL_PROVIDER: 'smtp' (default) or 'resend'. Hosts that block outbound SMTP
# (Render & most PaaS free tiers) MUST use 'resend' (HTTPS API on port 443).
EMAIL_PROVIDER=smtp
# From address + display name used by BOTH transports (falls back to SMTP_FROM).
# Use a domain you control that passes SPF/DKIM/DMARC, or mail is spam-filed.
EMAIL_FROM=
EMAIL_FROM_NAME=BRD Retrieval Engine

# Resend (used when EMAIL_PROVIDER=resend). onboarding@resend.dev reaches ONLY your
# Resend account email; verify a domain and set EMAIL_FROM=no-reply@yourdomain.com.
RESEND_API_KEY=

# SMTP (used when EMAIL_PROVIDER=smtp). Leave SMTP_HOST unset for DEV MODE: emails
# (incl. links/codes) are logged to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
# Transport security: starttls (587) | ssl (465, implicit TLS) | none (dev relays)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# From address (defaults to EMAIL_FROM/SMTP_USER) and optional display name.
SMTP_FROM=
SMTP_FROM_NAME=BRD Retrieval Engine

# ---- Email outbox / retry (durable send) ----
# Failed sends are retried at a FIXED interval (kinder UX than exponential backoff).
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_INTERVAL_SECONDS=180     # 3 minutes between retries
EMAIL_SWEEP_INTERVAL_SECONDS=30      # how often the background sweeper checks for due mail
EMAIL_LEASE_SECONDS=300              # a 'sending' row is reclaimable after this (crashed worker)
EMAIL_RECIPIENT_COOLDOWN_SECONDS=3600  # after a dead-letter, suppress new mail to that address

# ---- OTP (emailed 6-digit codes) ----
# Used for signup verification, password reset, and periodic login step-up.
OTP_TTL_MINUTES=10        # code lifetime
OTP_MAX_ATTEMPTS=5        # wrong guesses before a code is invalidated
OTP_LOGIN_EVERY=10        # require a login code every Nth login per user

# ---- Custom LLM (bring-your-own-key) ----
# Fernet key that encrypts each user's provider API key at rest. Unset = feature off.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_SECRET=8rY5aC8JnrKtYfop1OwOAQQs4NCqQo-IOpfAJEx1pa0=
