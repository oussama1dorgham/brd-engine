# secrets — ignore .env and any filled variant, but keep the .env.example template
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# data (drop real BRDs here; keep them out of version control)
data/brds/

# node
node_modules/
frontend/dist/

# local object storage (STORAGE_BACKEND=local): uploaded BRDs + test evidence, never commit
data/objects/
